# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (back_urls do Checkout Pro).
APP_URL="https://institutodelphos.com.br"

# Firebase Web App (Console → Project settings → Your apps)
# Para login Google: Authentication → Sign-in method → Google (ativar)
# e habilitar Identity Toolkit API no Google Cloud do mesmo projeto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Functions (opcional — defaults: us-central1 + projectId do Firebase)
# VITE_FUNCTIONS_REGION=us-central1
# VITE_FUNCTIONS_URL=https://us-central1-eventosociais-c057d.cloudfunctions.net

# Login admin: somente Gmail (Google Sign-In). Sem senha / sem controleadmin.
# Cadastre Gmails em /controle/permissoes
# Pedidos sem permissão são enviados para augustovogel82@gmail.com
# Domínios autorizados no Firebase Auth: localhost, eventos-sociais.vercel.app, institutodelphos.com.br
#
# Google Sign-In (Console → Authentication → Sign-in method → Google):
# Web Client ID do projeto eventosociais-c057d (878802346786-…apps.googleusercontent.com)
# Client Secret só no Console Firebase — NUNCA em VITE_* nem no Git.
#
# Imagens (logos instituições/parceiros + banners):
# - Coleção Firestore `imagens` (ativa agora; não precisa de billing)
# - Firebase Storage (opcional): ative billing + Storage no Console para URLs CDN
#
# Credenciais OAuth (Client ID + Secret) vão no Console do Firebase/Google,
# NÃO em variáveis VITE_* (o secret não pode ir para o frontend).

# ---- Mercado Pago (somente Cloud Functions — NUNCA VITE_*) ----
# Valores reais em functions/.env (gitignored). Produção:
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-…
# MERCADOPAGO_PUBLIC_KEY=APP_USR-…
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_APPLICATION_ID=
# MERCADOPAGO_USER_ID=
# MERCADOPAGO_MODE=production
# APP_URL=https://institutodelphos.com.br
# Nunca MERCADOPAGO_MODE=sandbox com token APP_USR-
# Sync merge-safe: node scripts/sync-functions-env.mjs
#
# Webhook URL (painel Mercado Pago):
# https://us-central1-eventosociais-c057d.cloudfunctions.net/mpWebhook

# ---- Resend (e-mail — ativar após domínio oficial) ----
# RESEND_API_KEY=
# EMAIL_FROM=DELPHOS <ingressos@dominio-oficial.com>
# Sem API Key o checkout continua; e-mails ficam enfileirados (logs).

# Web Push (avisos no app instalado) — chave privada só nas Cloud Functions
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ingressos@institutodelphos.com.br

# Web Push (avisos no app instalado) — chave privada só nas Cloud Functions
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ingressos@institutodelphos.com.br
