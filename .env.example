# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web App (Console → Project settings → Your apps)
# Para login Google: Authentication → Sign-in method → Google (ativar)
# e habilitar Identity Toolkit API no Google Cloud do mesmo projeto.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Login admin — e-mail Google mapeado (opcional)
VITE_ADMIN_LOGIN_EMAIL=controleadmin@delphos.local

# Ative o provedor Google em Firebase Console → Authentication → Sign-in method
# Cadastre e-mails autorizados em /controle/permissoes
# Domínios autorizados: localhost, eventos-sociais.vercel.app
#
# Credenciais OAuth (Client ID + Secret) vão no Console do Firebase/Google,
# NÃO em variáveis VITE_* (o secret não pode ir para o frontend).

# Seed (opcional) — npm run seed
# SEED_ADMIN_EMAIL=controleadmin@delphos.local
# SEED_ADMIN_PASSWORD=admin@vogel
