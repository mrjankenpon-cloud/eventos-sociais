rules_version = '2';

/**
 * DELPHOS — Firestore Security Rules (RBAC)
 *
 * Checkout / tickets / estoque de pagamento: somente Admin SDK (Cloud Functions).
 * Público não cria pedidos nem tickets diretamente.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isMaster() {
      return signedIn() && (
        request.auth.token.master == true
        || request.auth.uid == 'dNnYanNjrgWA5CXUfJjEZKCIJhm2'
      );
    }

    function hasTokenRole() {
      return signedIn() && request.auth.token.keys().hasAny(['role']);
    }

    function tokenRoleOk(roles) {
      return hasTokenRole()
        && request.auth.token.role in roles
        && (
          !request.auth.token.keys().hasAny(['ativo'])
          || request.auth.token.ativo == true
        );
    }

    function docRoleOk(roles) {
      return signedIn()
        && userDoc().data.ativo == true
        && userDoc().data.role in roles;
    }

    /** Prefer claims; só faz get() se o token ainda não tiver role. */
    function hasRole(roles) {
      return isMaster()
        || tokenRoleOk(roles)
        || (!hasTokenRole() && docRoleOk(roles));
    }

    function isAdmin() {
      return isMaster() || hasRole(['admin']);
    }

    function isEditor() {
      return isAdmin() || hasRole(['admin', 'editor']);
    }

    function isOperador() {
      return isAdmin() || hasRole(['admin', 'editor', 'operador']);
    }

    function isStaff() {
      return isAdmin() || hasRole(['admin', 'editor', 'operador', 'viewer']);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function preservesMaster(userId) {
      return userId != 'dNnYanNjrgWA5CXUfJjEZKCIJhm2'
        || (
          request.resource.data.role == 'admin'
          && request.resource.data.ativo == true
          && request.resource.data.master == true
        );
    }

    function stringInRange(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen;
    }

    function isValidLogCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['acao', 'colecao', 'documentoId', 'descricao'])
        && stringInRange(d.acao, 1, 40)
        && stringInRange(d.colecao, 1, 40)
        && stringInRange(d.documentoId, 1, 128)
        && stringInRange(d.descricao, 1, 500)
        && (
          signedIn()
          || (d.acao == 'create' && d.colecao == 'pedidos')
          || d.acao == 'email_queued'
        );
    }

    /**
     * Evento visível no site público.
     * Soft-delete grava status='arquivado' e publicado=false — sai desta regra.
     * Importante: NÃO adicionar filtros extras (ex.: arquivado!=true) que a
     * query pública não replica — o Firestore rejeitaria o list inteiro.
     */
    function eventoPublico() {
      return resource.data.status == 'publicado'
        || resource.data.publicado == true;
    }

    // ---- usuarios ----
    match /usuarios/{userId} {
      allow get: if signedIn() && (
        isSelf(userId)
        || userId == request.auth.token.email
        || (resource != null && resource.data.email == request.auth.token.email)
        || isStaff()
      );
      allow list: if isStaff();
      allow create: if
        request.resource.data.get('master', false) != true
        && (
          isAdmin()
          || (isMaster() && isSelf(userId))
          || (
            signedIn()
            && isSelf(userId)
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role in ['admin', 'editor', 'operador', 'viewer']
          )
        );
      allow update: if preservesMaster(userId) && (
        isAdmin()
        || (isSelf(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.get('master', false)
            == resource.data.get('master', false))
      );
      allow delete: if isAdmin() && userId != 'dNnYanNjrgWA5CXUfJjEZKCIJhm2';
    }

    // ---- eventos ----
    match /eventos/{eventoId} {
      allow read: if eventoPublico() || isStaff();
      allow create: if isEditor();
      // Soft-delete preferido; hard delete só admin
      allow delete: if isAdmin();
      allow update: if isEditor();
    }

    // ---- imagens (logos instituições/parceiros + banners) ----
    match /imagens/{id} {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.keys().hasAll([
          'pasta', 'tipo', 'contentType', 'base64', 'width', 'height', 'bytes'
        ])
        && request.resource.data.base64 is string
        && request.resource.data.base64.size() > 0
        && request.resource.data.base64.size() < 1200000
        && request.resource.data.bytes is number
        && request.resource.data.bytes > 0
        && request.resource.data.bytes < 900000;
      allow delete: if isEditor();
    }

    // ---- banners ----
    match /banners/{id} {
      allow read: if resource.data.ativo == true || isStaff();
      allow write: if isEditor();
    }

    // ---- patrocinadores / instituicoes ----
    match /patrocinadores/{id} {
      allow read: if resource.data.ativo == true || isStaff();
      allow write: if isEditor();
    }

    match /instituicoes/{id} {
      allow read: if resource.data.ativo == true || isStaff();
      allow write: if isEditor();
    }

    // ---- videos (carrossel da home) ----
    match /videos/{id} {
      allow read: if resource.data.ativo == true || isStaff();
      allow write: if isEditor();
    }

    // ---- ingressos (tipos) — estoque só via Admin SDK ----
    match /ingressos/{id} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    // ---- pedidos — create/update financeiro só Admin SDK ----
    match /pedidos/{id} {
      allow read: if isOperador();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // ---- pagamentos (histórico MP) — só Admin SDK escreve ----
    match /pagamentos/{id} {
      allow read: if isOperador();
      allow create, update, delete: if false;
    }

    // ---- tickets emitidos — create só Admin SDK ----
    // Operador só pode marcar check-in / retirada (não financeiro).
    match /tickets/{id} {
      allow read: if isOperador();
      allow create: if false;
      allow update: if isOperador()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'checkinRealizado',
            'checkinEm',
            'retiradaRealizada',
            'retiradaEm',
            'operador',
            'updatedAt'
          ])
        && request.resource.data.eventoId == resource.data.eventoId
        && request.resource.data.compraId == resource.data.compraId
        && request.resource.data.codigo == resource.data.codigo
        && request.resource.data.hash == resource.data.hash;
      allow delete: if isAdmin();
    }

    // ---- checkins ----
    match /checkins/{id} {
      allow read: if isOperador();
      allow create, update: if isOperador();
      allow delete: if isAdmin();
    }

    // ---- guest access tokens (só Admin SDK) ----
    match /guestAccessTokens/{id} {
      allow read, write: if false;
    }

    // ---- pedidos de acesso ao painel (escrita só Admin SDK) ----
    match /accessRequests/{id} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'role', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ---- configuracoes ----
    match /configuracoes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- logs ----
    match /logs/{id} {
      allow read: if isAdmin() || hasRole(['editor']);
      allow create: if isValidLogCreate();
      allow update, delete: if isAdmin();
    }

    // ---- pushTokens (app instalado) ----
    match /pushTokens/{id} {
      allow create, update: if request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() > 10
        && request.resource.data.endpoint.size() < 2048
        && request.resource.data.p256dh is string
        && request.resource.data.auth is string;
      allow read, delete: if isStaff();
    }

    match /pwaInstalls/{id} {
      allow create, update: if request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 8
        && request.resource.data.deviceId.size() < 128;
      allow get: if true;
      allow list, delete: if isStaff();
    }
  }
}
