rules_version = '2';

/**
 * DELPHOS — Firestore Security Rules (RBAC)
 *
 * Claims (preferidos, 0 leituras extras):
 *   request.auth.token.role   → 'admin' | 'editor' | 'operador' | 'viewer'
 *   request.auth.token.ativo  → true/false
 *   request.auth.token.master → true
 *
 * Fallback: leitura única de usuarios/{uid} (cacheada por avaliação de regra).
 *
 * Público: inscrição (pedido + tickets derivados) com validação de schema.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isMaster() {
      return signedIn() && (
        request.auth.token.master == true
        || request.auth.uid == 'dNnYanNjrgWA5CXUfJjEZKCIJhm2'
      );
    }

    function hasTokenRole() {
      return signedIn() && request.auth.token.keys().hasAny(['role']);
    }

    function tokenRoleOk(roles) {
      return hasTokenRole()
        && request.auth.token.role in roles
        && (
          !request.auth.token.keys().hasAny(['ativo'])
          || request.auth.token.ativo == true
        );
    }

    function docRoleOk(roles) {
      return signedIn()
        && userDoc().data.ativo == true
        && userDoc().data.role in roles;
    }

    /** Prefer claims; só faz get() se o token ainda não tiver role. */
    function hasRole(roles) {
      return isMaster()
        || tokenRoleOk(roles)
        || (!hasTokenRole() && docRoleOk(roles));
    }

    function isAdmin() {
      return isMaster() || hasRole(['admin']);
    }

    function isEditor() {
      return isAdmin() || hasRole(['admin', 'editor']);
    }

    function isOperador() {
      return isAdmin() || hasRole(['admin', 'editor', 'operador']);
    }

    function isStaff() {
      return isAdmin() || hasRole(['admin', 'editor', 'operador', 'viewer']);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function preservesMaster(userId) {
      return userId != 'dNnYanNjrgWA5CXUfJjEZKCIJhm2'
        || (
          request.resource.data.role == 'admin'
          && request.resource.data.ativo == true
          && request.resource.data.master == true
        );
    }

    function stringInRange(value, minLen, maxLen) {
      return value is string
        && value.size() >= minLen
        && value.size() <= maxLen;
    }

    /** Inscrição pública: schema rígido + status inicial pendente. */
    function isValidPedidoCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'nomeComprador', 'eventoId', 'quantidade', 'valorTotal', 'status', 'cpf', 'email'
        ])
        && stringInRange(d.nomeComprador, 2, 120)
        && stringInRange(d.eventoId, 1, 128)
        && stringInRange(d.cpf, 11, 14)
        && stringInRange(d.email, 5, 200)
        && d.quantidade is number
        && d.quantidade >= 1
        && d.quantidade <= 20
        && d.quantidade == int(d.quantidade)
        && d.valorTotal is number
        && d.valorTotal >= 0
        && d.valorTotal <= 100000
        && d.status == 'pendente'
        && (!('ativo' in d) || d.ativo == true)
        && (!('estoqueReservado' in d) || d.estoqueReservado is bool);
    }

    /** Tickets só no estado inicial (check-in ainda não feito). */
    function isValidTicketCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'codigo', 'hash', 'eventoId', 'compraId', 'status', 'checkinRealizado'
        ])
        && stringInRange(d.codigo, 6, 80)
        && stringInRange(d.hash, 16, 128)
        && stringInRange(d.eventoId, 1, 128)
        && stringInRange(d.compraId, 1, 128)
        && d.status == 'Disponível'
        && d.checkinRealizado == false
        && (!('ativo' in d) || d.ativo == true)
        && (!('ordem' in d) || (d.ordem is number && d.ordem >= 1 && d.ordem <= 20 && d.ordem == int(d.ordem)));
    }

    function isValidLogCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['acao', 'colecao', 'documentoId', 'descricao'])
        && stringInRange(d.acao, 1, 40)
        && stringInRange(d.colecao, 1, 40)
        && stringInRange(d.documentoId, 1, 128)
        && stringInRange(d.descricao, 1, 500)
        && (
          signedIn()
          || (d.acao == 'create' && d.colecao == 'pedidos')
        );
    }

    // ---- usuarios ----
    match /usuarios/{userId} {
      allow get: if signedIn() && (
        isSelf(userId)
        || userId == request.auth.token.email
        || (resource != null && resource.data.email == request.auth.token.email)
        || isStaff()
      );
      allow list: if isStaff();
      allow create: if isAdmin()
        || (isMaster() && isSelf(userId))
        || (signedIn()
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.ativo == true
          && request.resource.data.role in ['admin', 'editor', 'operador', 'viewer']);
      allow update: if preservesMaster(userId) && (
        isAdmin()
        || (isSelf(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.get('master', false)
            == resource.data.get('master', false))
      );
      allow delete: if isAdmin() && userId != 'dNnYanNjrgWA5CXUfJjEZKCIJhm2';
    }

    // ---- eventos ----
    match /eventos/{eventoId} {
      allow read: if resource.data.status == 'publicado'
        || resource.data.publicado == true
        || isStaff();
      allow create, delete: if isEditor();
      allow update: if isEditor()
        || (
          // Inscrição pública: só ajusta contador de vagas (não aumenta)
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantidadeRestante', 'updatedAt'])
          && request.resource.data.quantidadeRestante is number
          && request.resource.data.quantidadeRestante >= 0
          && (
            !('quantidadeRestante' in resource.data)
            || request.resource.data.quantidadeRestante
              <= resource.data.quantidadeRestante
          )
        );
    }

    // ---- imagens (logos instituições/parceiros + banners) ----
    match /imagens/{id} {
      allow read: if true;
      allow create, update: if isEditor()
        && request.resource.data.keys().hasAll([
          'pasta', 'tipo', 'contentType', 'base64', 'width', 'height', 'bytes'
        ])
        && request.resource.data.base64 is string
        && request.resource.data.base64.size() > 0
        && request.resource.data.base64.size() < 1200000
        && request.resource.data.bytes is number
        && request.resource.data.bytes > 0
        && request.resource.data.bytes < 900000;
      allow delete: if isEditor();
    }

    // ---- banners ----
    match /banners/{id} {
      allow read: if resource.data.ativo == true || isStaff();
      allow write: if isEditor();
    }

    // ---- patrocinadores / instituicoes ----
    match /patrocinadores/{id} {
      allow read: if resource.data.ativo == true || isStaff();
      allow write: if isEditor();
    }

    match /instituicoes/{id} {
      allow read: if resource.data.ativo == true || isStaff();
      allow write: if isEditor();
    }

    // ---- ingressos (tipos) ----
    match /ingressos/{id} {
      allow read: if true;
      allow create, delete: if isEditor();
      // Público pode só decrementar estoque na inscrição (via transaction do cliente)
      allow update: if isEditor()
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantidadeVendida', 'quantidadeDisponivel', 'updatedAt'])
          && request.resource.data.quantidadeVendida is number
          && request.resource.data.quantidadeVendida >= resource.data.quantidadeVendida
          && request.resource.data.quantidadeVendida <= resource.data.quantidade
        );
    }

    // ---- pedidos ----
    match /pedidos/{id} {
      allow read: if isOperador();
      allow create: if isValidPedidoCreate();
      allow update: if isEditor() || isOperador();
      allow delete: if isAdmin();
    }

    // ---- tickets emitidos ----
    match /tickets/{id} {
      allow read: if isOperador();
      allow create: if isValidTicketCreate();
      allow update: if isOperador();
      allow delete: if isAdmin();
    }

    // ---- checkins ----
    match /checkins/{id} {
      allow read: if isOperador();
      allow create, update: if isOperador();
      allow delete: if isAdmin();
    }

    // ---- configuracoes ----
    match /configuracoes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- logs ----
    match /logs/{id} {
      allow read: if isAdmin() || hasRole(['editor']);
      allow create: if isValidLogCreate();
      allow update, delete: if isAdmin();
    }
  }
}
