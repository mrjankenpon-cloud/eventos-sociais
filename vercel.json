{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!robots.txt|sitemap.xml|google-site-verification.txt|google-site-verification.html).*)",
      "destination": "/index.html"
    }
  ]
}
