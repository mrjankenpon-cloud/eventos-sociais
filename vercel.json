{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/doacoes", "destination": "/doacoes/index.html" },
    { "source": "/sobre", "destination": "/sobre/index.html" },
    { "source": "/termos", "destination": "/termos/index.html" },
    { "source": "/privacidade", "destination": "/privacidade/index.html" },
    {
      "source": "/((?!robots.txt|sitemap.xml|google-site-verification.txt|google-site-verification.html|doacoes|sobre|termos|privacidade).*)",
      "destination": "/index.html"
    }
  ]
}
