# Mercado Pago PRODUCTION (nomes apenas — valores em functions/.env local, gitignored)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_APPLICATION_ID=
MERCADOPAGO_USER_ID=
MERCADOPAGO_MODE=production
APP_URL=https://institutodelphos.com.br
# Nunca use MERCADOPAGO_MODE=sandbox com token APP_USR-
# Webhook no painel MP: https://us-central1-eventosociais-c057d.cloudfunctions.net/mpWebhook
#
# Após editar functions/.env, sincronize sem apagar outras vars:
#   node scripts/sync-functions-env.mjs
# (faz MERGE nas Cloud Functions — não substitua o mapa inteiro só com Resend)

# Resend — domínio verificado
RESEND_API_KEY=
EMAIL_FROM=DELPHOS <ingressos@institutodelphos.com.br>

# Web Push — gerar com: npx web-push generate-vapid-keys
# A pública também fica em src/lib/pushVapid.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ingressos@institutodelphos.com.br
