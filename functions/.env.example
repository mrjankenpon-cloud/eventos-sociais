# Mercado Pago TEST / sandbox (nomes apenas — valores em functions/.env local)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_APPLICATION_ID=
MERCADOPAGO_USER_ID=
MERCADOPAGO_MODE=sandbox
APP_URL=https://institutodelphos.com.br
# Comprador de teste (Checkout Pro) — distinto do vendedor
MP_TEST_BUYER_USERNAME=
MP_TEST_BUYER_EMAIL=

# Resend — domínio verificado
RESEND_API_KEY=
EMAIL_FROM=DELPHOS <ingressos@institutodelphos.com.br>

# Web Push — gerar com: npx web-push generate-vapid-keys
# A pública também fica em src/lib/pushVapid.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ingressos@institutodelphos.com.br
