rules_version = '2';

/**
 * DELPHOS — Firebase Storage Rules
 * Leitura pública | Escrita staff (claims primeiro; fallback usuarios/{uid})
 */
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isMaster() {
      return signedIn() && (
        request.auth.token.master == true
        || request.auth.uid == 'dNnYanNjrgWA5CXUfJjEZKCIJhm2'
      );
    }

    function isStaffWriter() {
      return isMaster()
        || (
          signedIn()
          && request.auth.token.keys().hasAny(['role'])
          && request.auth.token.role in ['admin', 'editor']
          && (
            !request.auth.token.keys().hasAny(['ativo'])
            || request.auth.token.ativo == true
          )
        )
        || (
          signedIn()
          && !request.auth.token.keys().hasAny(['role'])
          && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.ativo == true
          && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.role in ['admin', 'editor']
        );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function underMaxSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffWriter() && isImage() && underMaxSize();
    }

    match /patrocinadores/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffWriter() && isImage() && underMaxSize();
    }

    match /instituicoes/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffWriter() && isImage() && underMaxSize();
    }

    match /eventos/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffWriter() && isImage() && underMaxSize();
    }

    match /configuracoes/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffWriter() && isImage() && underMaxSize();
    }

    match /misc/{allPaths=**} {
      allow read: if true;
      allow write: if isStaffWriter() && isImage() && underMaxSize();
    }
  }
}
